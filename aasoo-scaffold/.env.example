# Aasoo Macrame — environment variables

Copy to `.env` and fill in. Never commit the real `.env`.

# Single shared admin password for /admin. CHANGE from the default before deploying.
ADMIN_PASSWORD=admin

# Telegram bot alerting (order notifications). Create a bot via @BotFather to get the token.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id — @userinfobot will report it.
TELEGRAM_CHAT_ID=

# SQLite database file name (created under aasoo-scaffold/data/ on first access)
SQLITE_FILE=aasoo.db

# Flat domestic shipping amount in integer toman (0 = free / settled with the buyer at delivery)
SHIPPING_FLAT_TOMAN=0

# Public site URL, used for the sitemap and absolute links
NEXT_PUBLIC_SITE_URL=https://aasoomacrame.ir
